bindsym $mod+n exec --no-startup-id swaync-client -t -sw


# ============================================================
# Screenshot Mode
# Super+Print opens the screenshot selection mode.
# ============================================================

set $screenshot_dir $HOME/Pictures
set $mode_screenshot (1) Area, (2) Active window, (3) Full screen
bindsym $mod+Print mode "$mode_screenshot"
mode "$mode_screenshot" {
    bindsym 1 exec --no-startup-id "$HOME/.config/sway/scripts/screenshot.sh area \"$screenshot_dir\""; mode "default"
    bindsym 2 exec --no-startup-id "$HOME/.config/sway/scripts/screenshot.sh window \"$screenshot_dir\""; mode "default"
    bindsym 3 exec --no-startup-id "$HOME/.config/sway/scripts/screenshot.sh screen \"$screenshot_dir\""; mode "default"
    bindsym Return mode "default"
    bindsym Escape mode "default"
}

# ============================================================
# Application Menu Modes
# Super+Q opens the application and system menus.
# ============================================================

#bindsym $mod+F12 exec synaptic-pkexec
set $mode_system (1) General apps, (2) Games, (3) Macros, (4) System, (9) Power
set $General_apps (1) Firefox, (2) FileMan, (3) Calculator, (4) TaskMan
set $Games (1) ScreenCap, (2) Steam.sh
set $System (1) Synaptic, (2) Settings, (3) Displays
set $Power (59) Shutdown, (6) Restart, (7) Logout (8) Suspend, (9) Lock
set $Displays (1) Home
set $Macros (1) Empty
bindsym $mod+q mode "$mode_system"

# ------------------------------------------------------------
# Main Menu
# ------------------------------------------------------------

mode "$mode_system" {
    bindsym 1 mode "$General_apps"
    bindsym 2 mode "$Games"
    bindsym 3 mode "$Macros"
    bindsym 4 mode "$System"
    bindsym 9 mode "$Power"
    bindsym Return mode "default"
    bindsym Escape mode "default"
}

# ------------------------------------------------------------
# General Applications
# ------------------------------------------------------------

mode "$General_apps" {
    bindsym 1 exec firefox, mode "default"
    bindsym 2 exec thunar, mode "default"
    bindsym 3 exec gnome-calculator, mode "default"
    bindsym 4 exec --no-startup-id xfce4-taskmanager, mode "default"
    bindsym Return mode "default"
    bindsym Escape mode "default"
}

# ------------------------------------------------------------
# Games
# ------------------------------------------------------------

mode "$Games" {
    bindsym 1 exec --no-startup-id obs, mode "default"
    bindsym 2 exec --no-startup-id steam, mode "default"
    bindsym Return mode "default"
    bindsym Escape mode "default"
}

# ------------------------------------------------------------
# System Utilities
# ------------------------------------------------------------

mode "$System" {
    #bindsym 1 exec --no-startup-id synaptic-pkexec, mode "default"
    bindsym 1 exec --no-startup-id ~/.config/sway/scripts/synaptic-sway.sh, mode "default"
    bindsym 2 exec --no-startup-id xfce4-settings-manager, mode "default"
    bindsym 3 exec --no-startup-id xfce4-display-settings, mode "default"
    bindsym Return mode "default"
    bindsym Escape mode "default"
}

# ------------------------------------------------------------
# Power and Session Controls
# ------------------------------------------------------------

mode "$Power" {
    bindsym 5 exec systemctl poweroff, mode "default"
    bindsym 6 exec systemctl reboot, mode "default"
    bindsym 7 exec swaymsg exit, mode "default"
    bindsym 8 exec systemctl suspend, mode "default"
    bindsym 9 exec "$HOME/.config/sway/scripts/lock.sh", mode "default"
    bindsym Return mode "default"
    bindsym Escape mode "default"
}

# ------------------------------------------------------------
# Macros
# ------------------------------------------------------------

mode "$Macros" {
    bindsym 1 mode "default"
    bindsym Return mode "default"
    bindsym Escape mode "default"
}

# ------------------------------------------------------------
# Desktop Help
# ------------------------------------------------------------

bindsym $mod+F1 exec foot --app-id sway-help -W 70x28 sh -c 'less -R "$HOME/.config/sway/help.txt"'

