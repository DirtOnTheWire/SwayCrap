# ============================================================
# Workspace assignments
# ============================================================

# Steam / Wine-related windows
assign [class="steam"] workspace number 2

# Float GTK portal file chooser, used by Steam and sandboxed apps
for_window [app_id="xdg-desktop-portal-gtk"] floating enable, move position center

# Misc app placement
#assign [title="PlayOnLinux"] workspace number 4
assign [app_id="thunar"] workspace number 9
#assign [class="Unreal"] workspace number 1

# Terminals
# Normal xfce4-terminal windows go to workspace 10,
# but the themectl-fzf helper terminal is excluded.
assign [app_id="xfce4-terminal" title="^(?!themectl-fzf$).*"] workspace number 10
assign [class="^Terminal$"] workspace number 10

# Browsers
assign [app_id="firefox"] workspace number 3
assign [app_id="chromium"] workspace number 3
assign [app_id="google-chrome"] workspace number 3

# Chat / comms
assign [class="Mumble"] workspace number 5
assign [class="TeamSpeak 3"] workspace number 5
