# Sway configuration.
# Load generated theme variables + client/bar colors
include ~/.config/sway/themes/current.conf


# Rounded windows
#corner_radius 8

# Soft drop shadows
#shadows enable
#shadows_on_csd enable
#shadow_blur_radius 28
#shadow_color #000000B8
#shadow_inactive_color #000000B8
#shadow_offset 0 6

# Fast, subtle motion
#animation_duration_ms 150


# All regular mice / external pointer devices
input "type:pointer" {
    accel_profile flat
    pointer_accel 0
    natural_scroll disabled
    left_handed disabled
    middle_emulation disabled
}

# All trackpoints / pointing sticks
#input "type:trackpoint" {
#    accel_profile flat
#    pointer_accel 1
#    natural_scroll disabled
#    middle_emulation enabled
#}

# All touchpads / trackpads
#input "type:touchpad" {
#    tap enabled
#    natural_scroll enabled
#    dwt enabled
#    middle_emulation enabled
#    pointer_accel 0
#    accel_profile adaptive
#}

# All keyboards
input "type:keyboard" {
    xkb_layout us
    xkb_variant ""
    xkb_options ctrl:nocaps
    xkb_numlock enabled
    repeat_delay 300
    repeat_rate 40
}

xwayland enable


set $mod Mod4
set $mod2 --whole-window --border button8
#set $mod2 mod2

#extra settings

focus_follows_mouse no

font pango:monospace 8



# ============================================================
# Autostart Applications
# Session services, panels, notifications, and desktop utilities.
# ============================================================

# ------------------------------------------------------------
# Session Environment
# Export session variables for systemd and D-Bus services.
# ------------------------------------------------------------

exec systemctl --user import-environment DISPLAY WAYLAND_DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP XDG_SESSION_TYPE DBUS_SESSION_BUS_ADDRESS
exec dbus-update-activation-environment --systemd DISPLAY WAYLAND_DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP XDG_SESSION_TYPE DBUS_SESSION_BUS_ADDRESS

# ------------------------------------------------------------
# Network and Notifications
# NetworkManager tray and Sway Notification Center.
# ------------------------------------------------------------

exec --no-startup-id nm-applet --indicator
exec_always pkill xfce4-notifyd
exec_always --no-startup-id sh -c 'pkill -x swaync 2>/dev/null; sleep 0.2; swaync'

# Notification history monitor.
exec histuid --monitor

# ------------------------------------------------------------
# Panel and System Statistics
# Waybar and its background statistics helper.
# ------------------------------------------------------------

# Noctalia alternative: handles output hotplug itself.
#exec --no-startup-id noctalia --daemon

exec --no-startup-id ~/.config/waybar/launch.sh

# ------------------------------------------------------------
# Audio Tray and On-Screen Display
# ------------------------------------------------------------

# Optional legacy audio tray.
#exec --no-startup-id pasystray

# Alternative SwayOSD startup.
#exec sh -c 'sleep 10; exec swayosd-server'
exec ~/.config/sway/scripts/start-swayosd.sh

# ------------------------------------------------------------
# Clipboard Manager
# ------------------------------------------------------------

exec_always --no-startup-id sh -lc 'copyq exit 2>/dev/null || true; pkill -x copyq 2>/dev/null || true; copyq --start-server'

# ------------------------------------------------------------
# Power Management and Locking
# XFCE handles power management; Sway lock hook is optional.
# ------------------------------------------------------------

exec_always --no-startup-id xfce4-power-manager --daemon

# Disable presentation mode at session startup/reload.
exec_always --no-startup-id sh -c 'xfconf-query -c xfce4-power-manager -p /xfce4-power-manager/presentation-mode -s false || xfconf-query -c xfce4-power-manager -p /xfce4-power-manager/presentation-mode -n -t bool -s false'

# Optional Sway idle/sleep locking (currently disabled).
#exec --no-startup-id swayidle -w \
#before-sleep "$HOME/.config/sway/scripts/lock.sh"

# ------------------------------------------------------------
# Wallpaper
# ------------------------------------------------------------

exec_always --no-startup-id swaybg -i ~/Pictures/Wallpapers/Blue_Lightcycle.png -m fill

# ------------------------------------------------------------
# Bluetooth and XFCE Appearance
# ------------------------------------------------------------

exec --no-startup-id blueman-applet
exec --no-startup-id xfsettingsd


# ============================================================
# PolicyKit Authentication Agent
# Enable ONE authentication agent at a time.
# ============================================================

# XFCE Polkit
#exec --no-startup-id xfce-polkit

# MATE Polkit
exec --no-startup-id /usr/libexec/polkit-mate-authentication-agent-1

# GNOME Polkit
#exec --no-startup-id /usr/lib/policykit-1-gnome/polkit-gnome-authentication-agent-1



