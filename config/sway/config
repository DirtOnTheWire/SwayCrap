# ============================================================
# Audio Controls - PipeWire / WirePlumber + SwayOSD
# wpctl handles volume independently of SwayOSD.
# ============================================================

# ------------------------------------------------------------
# Multimedia Keyboard Volume Keys
# ------------------------------------------------------------

bindsym XF86AudioRaiseVolume exec sh -c 'wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 5%+; timeout 1s swayosd-client --output-volume +0 >/dev/null 2>&1 || true'
bindsym XF86AudioLowerVolume exec sh -c 'wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-; timeout 1s swayosd-client --output-volume +0 >/dev/null 2>&1 || true'
bindsym XF86AudioMute exec sh -c 'wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle; timeout 1s swayosd-client --output-volume +0 >/dev/null 2>&1 || true'

# ------------------------------------------------------------
# Super Key Volume Controls
# ------------------------------------------------------------

bindsym $mod+equal exec sh -c 'wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 5%+; timeout 1s swayosd-client --output-volume +0 >/dev/null 2>&1 || true'
bindsym $mod+minus exec sh -c 'wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-; timeout 1s swayosd-client --output-volume +0 >/dev/null 2>&1 || true'
bindsym $mod+BackSpace exec sh -c 'wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle; timeout 1s swayosd-client --output-volume +0 >/dev/null 2>&1 || true'

# ------------------------------------------------------------
# Mouse Wheel Volume Controls
# ------------------------------------------------------------

bindsym --whole-window $mod+button4 exec sh -c 'wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 5%+; timeout 1s swayosd-client --output-volume +0 >/dev/null 2>&1 || true'
bindsym --whole-window $mod+button5 exec sh -c 'wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-; timeout 1s swayosd-client --output-volume +0 >/dev/null 2>&1 || true'


